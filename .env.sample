# Central Supabase ingestion.
#
# Copy to `.env`. When CENTRAL_SUPABASE_URL / CENTRAL_SUPABASE_SERVICE_KEY are
# missing the scrapers keep working: everything is written to the local SQLite
# outbox and pushed centrally as soon as credentials are configured.

# Self-hosted ("local") Supabase behind the recruitment deployment. Point this
# at a hosted project instead when you are not running against that box.
CENTRAL_SUPABASE_URL=http://rekrutmen-supabase-a4b9d1-122-49-230-39.sslip.io
CENTRAL_SUPABASE_SERVICE_KEY=your-service-role-key

# Direct portal scoring sink (all sink-routed portals; see the README's
# "Supabase sink" section). Use the self-hosted Supabase API base and its
# anon key; artifacts are private and can only be inserted by anon.
SCORING_SUPABASE_URL=http://rekrutmen-supabase-a4b9d1-122-49-230-39.sslip.io
SCORING_SUPABASE_ANON_KEY=your-anon-key
SCORING_SUPABASE_BUCKET=scrape-artifacts

# Service-role key for the two service-only surfaces: the
# scrape.glints_verification code hand-off table (no anon grants) and the
# private session object glints/session/current.json in the bucket (anon is
# insert-only and cannot read or overwrite). Runtime secret — deployment env
# only. Without it the scraper still works, but a Glints device-verification
# interstitial cannot be passed and a verified session is not persisted
# across container restarts.
SCORING_SUPABASE_SERVICE_KEY=

# Schema holding the scraped mirror tables (see migrations/0001_central_ingestion.sql).
CENTRAL_SCRAPER_SCHEMA=scraper

# Talent table freshly scraped candidates are streamed into
# (see migrations/0002_talent_scraping.sql).
CENTRAL_TALENT_SCHEMA=public
CENTRAL_TALENT_TABLE=talent_scraping

# Candidate streaming. A batch leaves as soon as it holds MAX_BATCH rows or the
# FLUSH_MS window elapses, whichever comes first. Set STREAM_ENABLED=false to
# upsert every candidate on its own request instead.
CENTRAL_TALENT_STREAM_ENABLED=true
CENTRAL_TALENT_STREAM_FLUSH_MS=2000
CENTRAL_TALENT_STREAM_MAX_BATCH=25

# Schema holding the IDRKOS / auth tables.
CENTRAL_AUTH_SCHEMA=radixa_auth

# Set to false to write to the local outbox only.
CENTRAL_INGESTION_ENABLED=true

# Local SQLite fallback. Defaults to db/central.db.
CENTRAL_LOCAL_DB_PATH=db/central.db

# Background sync runner.
CENTRAL_SYNC_INTERVAL_MS=300000
CENTRAL_SYNC_BATCH_SIZE=50
CENTRAL_SYNC_MAX_ATTEMPTS=10
CENTRAL_REQUEST_TIMEOUT_MS=30000

# IDRKOS cross-check.
#   rpc  - only call the cross_check_idrkos_candidate Postgres function
#   api  - only call the IDRKOS /talents API
#   auto - try the RPC first, fall back to the API (default)
IDRKOS_MODE=auto
IDRKOS_BASE_URL=https://idrkos.example.com/api
IDRKOS_API_KEY=your-idrkos-token
IDRKOS_TALENTS_PATH=/talents

# Glints employer credential login (src/portalLogin.ts + src/glints.ts).
# Runtime secrets: set them in the deployment environment only — never commit
# values, and never put them in glints.json. When the injected session from
# glints.json is missing or expired the scraper logs in with these and keeps
# the refreshed session in memory; glints.json's cookies are just an optional
# warm-start. Login attempts are capped per process (2 consecutive failures,
# then a long backoff) so a wrong password cannot loop into a lockout.
#
# From an untrusted device (the server) Glints follows the credential submit
# with a "Verifikasi diri Anda" device-verification interstitial. The scraper
# then requests the EMAIL code, opens a row in scrape.glints_verification
# (needs SCORING_SUPABASE_SERVICE_KEY above), and logs
# GLINTS_VERIFICATION_CODE_NEEDED; a human writes the emailed code into that
# row within 10 minutes and the scraper completes the verification, then
# persists the now-trusted session to the bucket so restarts reuse it. Code
# emails are capped at one per 30 minutes via the row timestamps.
GLINTS_EMAIL=
GLINTS_PASSWORD=

# Portal scraper retries (src/retry.ts). A failed Playwright run is retried
# from scratch with exponential backoff until it succeeds or the attempt
# budget runs out.
SCRAPER_RETRY_MAX_ATTEMPTS=5
SCRAPER_RETRY_BASE_DELAY_MS=30000
SCRAPER_RETRY_MAX_DELAY_MS=300000
SCRAPER_RETRY_FACTOR=2
SCRAPER_RETRY_JITTER=true
SCRAPER_INTERVAL_MS=300000

# Viewer AI proxy (src/viewer.ts). Upstream API key for the /api/ai/* proxy
# behind the dashboard's PageAgent chat panel. Either name works.
NINE_ROUTER_KEY=your-9router-api-key
